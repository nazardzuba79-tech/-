# SOURCE ONLY: include INSIDE the existing api.voltextech.net TLS server,
# only after owner approval. Never put this into the Pages frontend Nginx.
# Keep normal /api/v1/auth/*, /api/v1/me and all other routes unchanged.
location ^~ /__stocks_global/ {
    limit_except GET DELETE { deny all; }
    client_max_body_size 1k;
    proxy_connect_timeout 2s;
    proxy_read_timeout 15s;
    proxy_http_version 1.1;
    proxy_pass_request_headers off;
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-Stocks-Token $http_x_stocks_token;
    proxy_set_header X-Stocks-View $http_x_stocks_view;
    proxy_set_header X-Voltex-Stocks-Edge-Time $http_x_voltex_stocks_edge_time;
    proxy_set_header X-Voltex-Stocks-Edge-Nonce $http_x_voltex_stocks_edge_nonce;
    proxy_set_header X-Voltex-Stocks-Edge-Digest $http_x_voltex_stocks_edge_digest;
    proxy_set_header X-Voltex-Stocks-Edge-Signature $http_x_voltex_stocks_edge_signature;
    proxy_set_header Connection "";
    proxy_pass http://127.0.0.1:4438;
    add_header Cache-Control "no-store" always;
}
# Gateway-only PG authority is never a browser/public API. Private gateway
# reaches the API container directly, not this TLS vhost.
location ^~ /api/v1/stocks-test-cash {
    return 404;
}
