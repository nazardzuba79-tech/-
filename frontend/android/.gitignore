# Standard Android/Gradle build output — regenerated by the CI workflow
# (.github/workflows/android-build.yml) on every push, never hand-edited.
*.iml
.gradle
/local.properties
/.idea
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
google-services.json
/app/build
/app/release

# The web bundle Capacitor copies in from ../dist via `cap sync` — built
# fresh each run (see capacitor.config.ts), not something to version here.
/app/src/main/assets/public
