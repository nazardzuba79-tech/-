# Заповни це і назви файл ".env" (без .example) в тій самій папці, де docker-compose.yml

DOMAIN=exchange.твійдомен.com
DB_PASSWORD=придумай-довгий-надійний-пароль
JWT_SECRET=придумай-інший-довгий-випадковий-рядок
ALLOWED_ORIGINS=https://exchange.твійдомен.com
REGISTRATION_OPEN=true
# Шифрує секрети API-ключів у базі. Згенеруй командою: openssl rand -hex 32
API_KEY_ENCRYPTION_SECRET=встав-сюди-64-символьний-hex-рядок

# Депозити приймаються тільки в Bitcoin і Tron (USDT-TRC20) — обидві мережі
# працюють одразу, без реєстрації жодного платного ключа. Ethereum навмисно
# вимкнено: для нього потрібен окремий RPC-провайдер (Alchemy/Infura) —
# зайва заморочка для старту. Якщо колись знадобиться — код для цього вже
# є (EvmDepositVerifier), просто скажи.

# Bitcoin (перевіряється через публічне API, не потребує власного вузла)
BITCOIN_TREASURY_ADDRESS=bc1qТвояАдресаBitcoin
BITCOIN_NATIVE_ASSET=BTC
BITCOIN_MIN_CONFIRMATIONS=2

# Tron — для USDT в мережі TRC20
TRON_TREASURY_ADDRESS=TТвояАдресаTron
TRON_NATIVE_ASSET=TRX
TRON_MIN_CONFIRMATIONS=19
TRON_TOKENS=USDT:TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t:6
