DATABASE_URL="postgresql://user:password@localhost:5432/exchange"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3000
ALLOWED_ORIGINS="http://localhost:5173"
REGISTRATION_OPEN=true

# ---- Ethereum deposit config ----
# RPC_URL: get a free one from Alchemy, Infura, or a public RPC endpoint.
ETHEREUM_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY"
# TREASURY_ADDRESS: YOUR wallet address (e.g. your MetaMask public address 0x...).
# All team deposits on this chain go here. This is NOT a secret (it's a public
# address) but keep it correct — a typo here means deposits go nowhere recoverable.
ETHEREUM_TREASURY_ADDRESS="0xYourMetaMaskAddressHere"
ETHEREUM_MIN_CONFIRMATIONS=12
ETHEREUM_NATIVE_ASSET="ETH"
# Format: SYMBOL:contractAddress:decimals, comma-separated
ETHEREUM_TOKENS="USDT:0xdAC17F958D2ee523a2206206994597C13D831ec7:6,USDC:0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48:6"

# ---- Add more chains the same way, e.g. for Polygon: ----
# POLYGON_RPC_URL=...
# POLYGON_TREASURY_ADDRESS=0x... (can be the SAME MetaMask address, it works cross-EVM-chain)
# POLYGON_MIN_CONFIRMATIONS=30
# POLYGON_NATIVE_ASSET="MATIC"
# POLYGON_TOKENS="USDT:0xc2132D05D31c914a87C6611C10748AEb04B58e8F:6"
