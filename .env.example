DATABASE_URL="postgresql://user:password@localhost:5432/exchange"
# Only needed when DATABASE_URL points at a connection pooler (e.g. Neon's
# "-pooler" host, PgBouncer). Prisma migrations need a direct, non-pooled
# connection to hold a session-level advisory lock — pooled connections
# (especially PgBouncer in transaction mode) can't reliably hold it, which
# shows up as a `migrate deploy` timeout (P1002). Get the direct connection
# string from your provider (e.g. Neon dashboard -> Connection Details ->
# toggle off "Pooled connection") and set it here; DATABASE_URL keeps using
# the pooled connection for normal app traffic. If your DB has no pooler
# (e.g. local Postgres), set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/exchange"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3000
ALLOWED_ORIGINS="http://localhost:5173"
REGISTRATION_OPEN=true
# Encrypts API-key secrets at rest (see src/services/ApiKeyService.ts).
# Generate with: openssl rand -hex 32
API_KEY_ENCRYPTION_SECRET="change-me-to-a-64-char-hex-string"

# ---- CoinGecko (src/services/CoinGeckoService.ts) ----
# Optional but recommended: a free "Demo" plan key moves rankings/market-cap
# requests off CoinGecko's shared anonymous rate-limit pool (prone to
# throttling under real traffic) onto this app's own dedicated 100-calls/
# min, 10,000-calls/month quota. No credit card needed — sign up at
# coingecko.com/en/api/pricing, Developer's Dashboard -> API Keys -> Add New
# Key. App works fine without one too, just more exposed to rate-limiting.
# COINGECKO_API_KEY="CG-your-demo-api-key"

# Deposits support Bitcoin, Tron (USDT-TRC20), Ethereum and BSC (both:
# native coin + ERC-20/BEP-20 USDT), Solana (native SOL + USDT-SPL), and
# TON (native TON + USDT jetton) out of the box — every one of them works
# with a free service, no paid RPC/API provider needed anywhere below.
# Every network is OFF until you set at least its TREASURY_ADDRESS — an
# unconfigured chain just doesn't appear in the deposit UI, nothing breaks.
# Add another EVM chain (Polygon, Avalanche, Arbitrum, ...) later the exact
# same way as BSC below, just with its own env var prefix and its own entry
# in KNOWN_CHAINS (src/api/routes/deposits.ts) — see config/chains.ts.

# ---- Bitcoin deposit config ----
# Verified via a public Esplora-style block explorer API (Blockstream's by
# default) instead of an RPC provider — Bitcoin has no ERC-20-style tokens.
# TREASURY_ADDRESS: YOUR Bitcoin address (e.g. from Trust Wallet or Ledger).
BITCOIN_TREASURY_ADDRESS="bc1qYourBitcoinAddressHere"
BITCOIN_NATIVE_ASSET="BTC"
BITCOIN_MIN_CONFIRMATIONS=2
# Optional — defaults to Blockstream's public API. Point this at a
# self-hosted Esplora/Electrs instance if you'd rather not depend on a
# third party for verifying deposits.
# BITCOIN_API_URL="https://blockstream.info/api"

# ---- Tron deposit config (for USDT-TRC20) ----
# Verified via the TronGrid API. TREASURY_ADDRESS is YOUR Tron address
# (starts with "T", e.g. from Trust Wallet).
TRON_TREASURY_ADDRESS="TYourTronAddressHere"
TRON_NATIVE_ASSET="TRX"
TRON_MIN_CONFIRMATIONS=19
# TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t is the real USDT-TRC20 contract address
# on Tron mainnet — same for everyone, not something you need to look up.
TRON_TOKENS="USDT:TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t:6"
# Optional — get a free key at trongrid.io to raise the rate limit above
# TronGrid's shared public quota.
# TRON_API_KEY="your-trongrid-api-key"

# ---- Ethereum deposit config (native ETH + ERC-20 USDT) ----
# Two DIFFERENT free services power this, not one:
#  - RPC_URL: verifies one specific transaction at credit time. Optional —
#    defaults to https://ethereum.publicnode.com (free, no signup) if unset,
#    same zero-config treatment as Bitcoin/Tron above. Override this only if
#    you'd rather point at your own node or a different free provider (e.g.
#    https://eth.llamarpc.com).
#  - API_KEY: powers the admin's "incoming transfers" feed (Etherscan's
#    account API) — get a free key in ~2 minutes at https://etherscan.io/apis
#    (no payment, no credit card). Without it, deposits still work if the
#    admin already has a tx hash; only the auto-discovery feed needs it.
# TREASURY_ADDRESS: YOUR Ethereum address (e.g. from Trust Wallet/MetaMask).
ETHEREUM_TREASURY_ADDRESS="0xYourEthereumAddressHere"
ETHEREUM_NATIVE_ASSET="ETH"
# Optional — defaults to https://ethereum.publicnode.com.
# ETHEREUM_RPC_URL="https://ethereum.publicnode.com"
# 0xdAC17F958D2ee523a2206206994597C13D831ec7 is the real USDT (ERC-20)
# contract address on Ethereum mainnet — same for everyone.
ETHEREUM_TOKENS="USDT:0xdAC17F958D2ee523a2206206994597C13D831ec7:6"
# ETHEREUM_API_KEY="your-etherscan-api-key"

# ---- BSC deposit config (native BNB + BEP-20 USDT) ----
# Same EVM setup as Ethereum above, just pointed at BNB Smart Chain. RPC_URL
# is optional — defaults to https://bsc-dataseed.binance.org (free, no
# signup). The incoming-transfers feed needs its own BscScan API key
# (different service from Etherscan) — get one free at bscscan.com/apis.
BSC_TREASURY_ADDRESS="0xYourBscAddressHere"
BSC_NATIVE_ASSET="BNB"
# BSC_RPC_URL="https://bsc-dataseed.binance.org"
# 0x55d398326f99059fF775485246999027B3197955 is the real Binance-Peg USDT
# (BEP-20) contract address on BSC mainnet — same for everyone.
BSC_TOKENS="USDT:0x55d398326f99059fF775485246999027B3197955:18"
# BSC_API_URL="https://api.bscscan.com/api"
# BSC_API_KEY="your-bscscan-api-key"

# ---- Solana deposit config (native SOL + USDT-SPL) ----
# A single free public JSON-RPC endpoint does both jobs here (verifying one
# transaction AND listing recent transfers) — no separate explorer API or
# API key needed, unlike the EVM chains above.
SOLANA_TREASURY_ADDRESS="YourSolanaAddressHere"
SOLANA_NATIVE_ASSET="SOL"
# Optional — defaults to https://api.mainnet-beta.solana.com. A dedicated
# free-tier RPC provider (e.g. Helius, QuickNode) will be far less
# rate-limited if you expect real deposit volume.
# SOLANA_API_URL="https://api.mainnet-beta.solana.com"
# Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB is the real USDT (SPL token)
# mint address on Solana mainnet — same for everyone.
SOLANA_TOKENS="USDT:Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB:6"

# ---- TON deposit config (native TON + USDT jetton) ----
# Verified via tonapi.io's decoded-events API (a jetton transfer never
# actually touches your plain address on-chain — it lands on a per-owner
# jetton-wallet contract instead — tonapi resolves that for us). Works with
# no API key at a light rate limit; a free key from https://tonconsole.com
# raises it.
TON_TREASURY_ADDRESS="YourTonAddressHere"
TON_NATIVE_ASSET="TON"
# TON_API_URL="https://tonapi.io"
# TON_API_KEY="your-tonapi-key"
# EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs is the real USD₮ jetton
# master contract address on TON mainnet — same for everyone. Double-check
# it against Tether's own announcement before relying on it with real funds.
TON_TOKENS="USDT:EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs:6"

# ---- Live-chat support widget (src/services/SupportEmailService.ts) ----
# Every message sent through the floating chat widget emails this address.
# Leave unset and the app just logs what it would have sent — no crash,
# same "gracefully absent" pattern as an unconfigured deposit chain above.
# SUPPORT_ADMIN_EMAIL="support@yourdomain.com"
# Plain SMTP — works with SendGrid, Resend, Mailgun, AWS SES, or Gmail's
# own SMTP relay, whichever you already use. Point these at its relay.
# SMTP_HOST="smtp.yourprovider.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="apikey-or-username"
# SMTP_PASS="your-smtp-password-or-api-key"
# The From: address on outbound notification emails.
# SUPPORT_FROM_EMAIL="noreply@yourdomain.com"
# Optional: a dedicated inbound mailbox your provider forwards replies to
# (SendGrid Inbound Parse, Resend inbound webhook, etc.) — set this to that
# mailbox's address so the admin's Reply-To goes there instead of straight
# to the user. Required for automated two-way sync back into the widget;
# without it, an admin reply just goes to the user directly (still works
# manually, just not fed back into the chat window).
# SUPPORT_INBOUND_EMAIL="inbound@yourdomain.com"
# Shared secret your inbound-email relay must send as the
# X-Webhook-Secret header on POST /api/v1/support/webhook/inbound-email —
# required for that endpoint to accept anything at all (see support.ts).
# Generate with: openssl rand -hex 32
# SUPPORT_WEBHOOK_SECRET="change-me-to-a-long-random-string"

# ---- KYC submission notifications (src/services/KycEmailService.ts) ----
# Every KYC submission emails this address a copy of the submitted data
# AND the document photo/PDF as an attachment — a durable second copy,
# since the local uploads/kyc/ folder isn't guaranteed persistent storage
# (a redeploy or container restart can wipe it). Leave unset and the app
# just logs what it would have sent, same as SUPPORT_ADMIN_EMAIL above.
# Reuses the same SMTP_HOST/PORT/SECURE/USER/PASS as the support widget.
# KYC_ADMIN_EMAIL="compliance@yourdomain.com"
# The From: address on these emails.
# KYC_FROM_EMAIL="noreply@yourdomain.com"

# --- Email verification for new registrations -------------------------
# A newly registered account gets NO session until it enters the six-digit
# code emailed to it. The code itself is never stored: what goes in the
# database is an HMAC-SHA256 of it keyed by this secret, so a database dump
# alone cannot be brute-forced back into a working code (six digits is only
# a million possibilities).
#
# REQUIRED. The backend refuses to start without it — there is no fallback,
# no default, and it is never generated at runtime. It must ALSO be a
# different value from JWT_SECRET, and startup rejects them being equal:
# the two keys protect different things, sharing one means either leak costs
# you both, and neither could then be rotated independently.
#
# Set it to a long random string and keep it stable — changing it
# invalidates every outstanding verification code (they expire in 10
# minutes anyway). Generate one with, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# EMAIL_VERIFICATION_SECRET="generate-your-own-do-not-reuse-jwt-secret"
#
# The From: address on the verification email. Falls back to
# SUPPORT_FROM_EMAIL, then to a local placeholder.
# VERIFICATION_FROM_EMAIL="noreply@yourdomain.com"
#
# Delivery reuses the same SMTP_HOST/PORT/SECURE/USER/PASS above. With no
# SMTP_HOST configured, registration still creates the account but reports
# emailDelivered:false and the user is told the code could not be sent —
# it never claims a code went out that did not.
