//@version=6
// CSI REGIME_reduced — REDUCED Pine variant. STATUS: NOT_COMPILED_IN_TRADINGVIEW, NOT_BACKTESTED_IN_TV, NOT_PARITY_WITH_PYTHON.
// Inputs lost vs Python REGIME: stablecoin mcap change, stablecoin supply ratio, exchange netflow/balance, TVL, DEX volume,
// net-liquidity heuristic with the contractual 8-day lag, Fear & Greed, ETF flows, active addresses, tx count, spot volume (CM).
// Kept: trend (SMA200 distance, 90d momentum), realized vol, FRED broad dollar and real yield changes (TradingView publication
// timing differs from the Python contractual lag), ETH/BTC 30d change. Higher score = more favourable under pre-registered signs.
indicator("CSI REGIME_reduced (research-only)", overlay=false)
minHist = input.int(365, "Min history for percentile (days)")
smaDist = close / ta.sma(close, 200) - 1
mom90   = math.log(close / close[90])
rv30    = ta.stdev(math.log(close / close[1]), 30) * math.sqrt(365)
dxyB    = request.security("FRED:DTWEXBGS", "D", close, lookahead=barmerge.lookahead_off)
dfii    = request.security("FRED:DFII10", "D", close, lookahead=barmerge.lookahead_off)
ethbtc  = request.security("OKX:ETHBTC", "D", close, lookahead=barmerge.lookahead_off)
dxyChg  = dxyB / dxyB[21] - 1
ryChg   = dfii - dfii[21]
ethChg  = math.log(ethbtc / ethbtc[30])
f_pct(src, n) =>
    cnt = 0
    below = 0
    for i = 1 to n
        if not na(src[i])
            cnt += 1
            if src[i] < src
                below += 1
    cnt >= minHist ? below / cnt : na
lb = 5000
// signs: + smaDist, + mom90, - rv30, - dxyChg, - ryChg, + ethChg
parts = array.from(f_pct(smaDist, lb), f_pct(mom90, lb), 1 - f_pct(rv30, lb), 1 - f_pct(dxyChg, lb), 1 - f_pct(ryChg, lb), f_pct(ethChg, lb))
sum = 0.0
cnt = 0
for v in parts
    if not na(v)
        sum += v
        cnt += 1
score = cnt >= 3 ? sum / cnt : na
plot(barstate.isconfirmed ? score : na, "REGIME_reduced score", color=color.teal)
hline(0.5)
alertcondition(score > 0.8, "REGIME_reduced favourable", "REGIME_reduced > 0.8 (research-only)")
alertcondition(score < 0.2, "REGIME_reduced unfavourable", "REGIME_reduced < 0.2 (research-only)")
