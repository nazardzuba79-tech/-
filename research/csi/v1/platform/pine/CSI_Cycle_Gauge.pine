//@version=6
// CSI Cycle Gauge — price-only cycle valuation on the chart symbol (use a long daily BTC history, e.g. BITSTAMP:BTCUSD or INDEX:BTCUSD).
// STATUS: written for Pine v6, NOT compiled/tested in TradingView by the author (no editor access in the research runtime).
// Components (percent rank vs the last `lookback` daily bars, 100 = most expensive vs own history):
//   1) Mayer Multiple = close / SMA200            2) 2Y MA multiplier = close / SMA730
//   3) 200W MA distance = close / SMA1400 - 1     4) Power-law residual = log(close) - expanding OLS fit of log(close) on log(days since 2009-01-03)
// Research note: on 2011-2022 data the power-law residual was the only component with a consistent 365-day direction;
// evidence = ~8 independent observations. This is a gauge of "expensive vs own history", NOT a trade signal.
indicator("CSI Cycle Gauge (research-only)", overlay=false, max_bars_back=5000)
lookback = input.int(1500, "Percent-rank lookback (daily bars)", minval=365, maxval=4999)
showTable = input.bool(true, "Show table")

mayer  = close / ta.sma(close, 200)
ma2y   = close / ta.sma(close, 730)
ma200w = close / ta.sma(close, 1400) - 1

// expanding OLS of y = log(close) on x = log(days since genesis)
genesis = timestamp("UTC", 2009, 1, 3, 0, 0)
x = math.log(math.max(1.0, (time - genesis) / 86400000.0))
y = math.log(close)
var float sx = 0.0
var float sy = 0.0
var float sxx = 0.0
var float sxy = 0.0
var int   n = 0
if barstate.isconfirmed or barstate.islast
    sx  += x
    sy  += y
    sxx += x * x
    sxy += x * y
    n   += 1
float slope = n > 730 ? (n * sxy - sx * sy) / (n * sxx - sx * sx) : na
float icpt  = n > 730 ? (sy - slope * sx) / n : na
plResid = n > 730 ? y - (icpt + slope * x) : na

p1 = ta.percentrank(mayer, lookback)
p2 = ta.percentrank(ma2y, lookback)
p3 = ta.percentrank(ma200w, lookback)
p4 = ta.percentrank(plResid, lookback)

float acc = 0.0
int cnt = 0
for p in array.from(p1, p2, p3, p4)
    if not na(p)
        acc += p
        cnt += 1
score = cnt >= 2 ? acc / cnt : na

col = score >= 80 ? color.red : score <= 20 ? color.green : color.orange
plot(score, "Cycle gauge 0..100 (100 = expensive)", color=col, linewidth=2)
plot(p4, "Power-law residual rank", color=color.new(color.blue, 40))
hline(80, "expensive zone", color=color.red)
hline(20, "cheap zone", color=color.green)
hline(50)

if showTable and barstate.islast
    var table t = table.new(position.top_right, 2, 6, border_width=1)
    table.cell(t, 0, 0, "Component", bgcolor=color.gray, text_color=color.white)
    table.cell(t, 1, 0, "Rank", bgcolor=color.gray, text_color=color.white)
    table.cell(t, 0, 1, "Mayer " + str.tostring(mayer, "#.##"))
    table.cell(t, 1, 1, str.tostring(p1, "#"))
    table.cell(t, 0, 2, "2Y MA x " + str.tostring(ma2y, "#.##"))
    table.cell(t, 1, 2, str.tostring(p2, "#"))
    table.cell(t, 0, 3, "200W dist " + str.tostring(ma200w * 100, "#") + "%")
    table.cell(t, 1, 3, str.tostring(p3, "#"))
    table.cell(t, 0, 4, "Power-law resid " + str.tostring(plResid, "#.##"))
    table.cell(t, 1, 4, str.tostring(p4, "#"))
    table.cell(t, 0, 5, "GAUGE", bgcolor=col)
    table.cell(t, 1, 5, str.tostring(score, "#"), bgcolor=col)

alertcondition(ta.crossover(score, 80), "Cycle gauge > 80", "CSI Cycle Gauge entered the expensive zone (research-only)")
alertcondition(ta.crossunder(score, 20), "Cycle gauge < 20", "CSI Cycle Gauge entered the cheap zone (research-only)")
