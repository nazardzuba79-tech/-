//@version=6
// CSI Cycle Gauge v3 (research-only).
// STATUS: written for Pine v6; syntax-checked offline with an independent parser; NOT compiled in TradingView by the author.
// What it shows: where the daily close sits relative to its long log-log trend (power-law residual), as a percentile of
// the last `lookback` days (100 = most expensive vs that window). Evidence from the Python study (2011-2026): this was the
// only valuation component with a consistent 365-day direction, but only ~3-8 independent cycles exist, so the effect is
// NOT statistically proven, and as a standalone exposure rule it lagged buy-and-hold in 2014-2022. Use it as context.
// Chart: a daily BTC chart with long history, e.g. BITSTAMP:BTCUSD (the Python replica uses Bitstamp).
indicator("CSI Цикл (дорого/дешево)", shorttitle="CSI Cycle", overlay=false, max_bars_back=5000)

lookback = input.int(1461, "Вікно перцентиля, днів", minval=365, maxval=4999)
showCtx = input.bool(false, "Показати допоміжні лінії (Mayer, 200W)")

genesis = timestamp("UTC", 2009, 1, 3, 0, 0)
xDays = math.log(math.max(1.0, (time - genesis) / 86400000.0))
yLog = math.log(close)

var float sx = 0.0
var float sy = 0.0
var float sxx = 0.0
var float sxy = 0.0
var int n = 0
sx += xDays
sy += yLog
sxx += xDays * xDays
sxy += xDays * yLog
n += 1

float resid = na
if n > 730
    float slope = (n * sxy - sx * sy) / (n * sxx - sx * sx)
    float icpt = (sy - slope * sx) / n
    resid := yLog - (icpt + slope * xDays)

validCnt = ta.cum(na(resid) ? 0 : 1)
prRaw = ta.percentrank(resid, lookback)
gauge = validCnt > lookback ? prRaw : na

mayer = close / ta.sma(close, 200)
ma200w = close / ta.sma(close, 1400) - 1
pMayer = ta.percentrank(mayer, lookback)
p200w = ta.percentrank(ma200w, lookback)

col = gauge >= 80 ? color.red : gauge <= 20 ? color.green : color.orange
plot(gauge, "Цикл 0..100 (100 = дорого)", color=col, linewidth=2)
plot(showCtx ? pMayer : na, "Mayer, перцентиль", color=color.new(color.gray, 40))
plot(showCtx ? p200w : na, "200W, перцентиль", color=color.new(color.blue, 40))
hline(80, "Зона дорожнечі", color=color.red)
hline(20, "Зона дешевизни", color=color.green)
hline(50, "Середина", color=color.gray)

var table t = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "CSI Цикл", bgcolor=color.gray, text_color=color.white)
    table.cell(t, 1, 0, na(gauge) ? "-" : str.tostring(gauge, "#"), bgcolor=col, text_color=color.white)
    table.cell(t, 0, 1, "Відхилення від тренду (ln)")
    table.cell(t, 1, 1, na(resid) ? "-" : str.tostring(resid, "#.##"))
    table.cell(t, 0, 2, "Mayer Multiple")
    table.cell(t, 1, 2, str.tostring(mayer, "#.##"))
    table.cell(t, 0, 3, "Статус")
    table.cell(t, 1, 3, "дослідження, не сигнал")

alertcondition(ta.crossover(gauge, 80), "Цикл вище 80", "CSI Цикл: зона дорожнечі (дослідження, не торговий сигнал)")
alertcondition(ta.crossunder(gauge, 20), "Цикл нижче 20", "CSI Цикл: зона дешевизни (дослідження, не торговий сигнал)")
