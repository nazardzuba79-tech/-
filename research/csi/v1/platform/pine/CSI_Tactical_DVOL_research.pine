//@version=6
// CSI Tactical DVOL + premium (RESEARCH-ONLY).
// STATUS: written for Pine v6; syntax-checked offline with an independent parser; NOT compiled in TradingView by the author.
// The parent TACTICAL system FAILED the pre-registered walk-forward test (pooled out-of-sample IC 2019-2022 = -0.07) and
// its daily turnover cost about 4-5% per year. This script only shows the two v2 TACTICAL inputs available in TradingView:
// Deribit DVOL implied-volatility index (higher = more favourable) and the 3-day Coinbase premium (higher = more favourable).
// The symbol DERIBIT:DVOL is assumed; if it does not exist in your TradingView, change the input or the DVOL part is skipped.
indicator("CSI Тактика: DVOL і премія (дослідження)", shorttitle="CSI Tactical", overlay=false)

symDV = input.symbol("DERIBIT:DVOL", "Deribit DVOL")
symCB = input.symbol("COINBASE:BTCUSD", "Coinbase BTC/USD")
symBS = input.symbol("BITSTAMP:BTCUSD", "Bitstamp BTC/USD")
winPR = input.int(365, "Вікно перцентиля, днів", minval=90)

dvol = request.security(symDV, "D", close, ignore_invalid_symbol=true)
cb = request.security(symCB, "D", close, ignore_invalid_symbol=true)
bs = request.security(symBS, "D", close, ignore_invalid_symbol=true)
cbPrem3 = ta.sma(cb / bs - 1, 3)

f_pr(float src, int len) =>
    float raw = ta.percentrank(src, len)
    float valid = ta.cum(na(src) ? 0 : 1)
    valid > len ? raw : na

p1 = f_pr(dvol, winPR)
p2 = f_pr(cbPrem3, winPR)

float acc = 0.0
int cnt = 0
if not na(p1)
    acc += p1
    cnt += 1
if not na(p2)
    acc += p2
    cnt += 1
score = cnt >= 1 ? acc / cnt : na

plot(score, "Тактика 0..100 (100 = сприятливо)", color=color.purple, linewidth=2)
hline(50, "Середина", color=color.gray)

var table t = table.new(position.top_right, 2, 3, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "Тактика", bgcolor=color.gray, text_color=color.white)
    table.cell(t, 1, 0, na(score) ? "-" : str.tostring(score, "#"))
    table.cell(t, 0, 1, "DVOL")
    table.cell(t, 1, 1, na(dvol) ? "немає символу" : str.tostring(dvol, "#.#"))
    table.cell(t, 0, 2, "Статус")
    table.cell(t, 1, 2, "не пройшов перевірку")
