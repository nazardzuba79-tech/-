// Prisma schema — the source of truth for exchange data.
// Run `npm run prisma:migrate` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Used only for `prisma migrate deploy`, never at runtime. Neon's pooled
  // connection (the normal DATABASE_URL, routed through PgBouncer in
  // transaction mode) doesn't reliably hold the session-level advisory
  // lock Prisma takes before applying migrations — that's what was
  // causing the intermittent "P1002 ... Timed out trying to acquire a
  // postgres advisory lock" deploy failures. A direct (unpooled)
  // connection doesn't have that problem. See:
  // https://pris.ly/d/migrate-advisory-locking
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  /// Sole source of truth for admin access (see requireAdmin middleware) —
  /// never derive access from the email address in application code.
  /// Auto-assigned ADMIN at registration for exactly one email (see
  /// src/api/routes/auth.ts); everyone else registers as USER. Promote
  /// further accounts only via a direct DB update, same deliberately
  /// manual bar as the old isAdmin boolean had.
  role          Role      @default(USER)
  kycStatus     KycStatus @default(NOT_STARTED)
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
  /// Bcrypt hashes of one-time recovery codes, issued once when 2FA is
  /// enabled and consumed (removed from the array) as they're used to log
  /// in without an authenticator app. Never store these in plaintext.
  twoFactorBackupCodes String[] @default([])
  /// Set when the user joins the crypto card waitlist (see src/api/routes/card.ts).
  /// Requires kycStatus == APPROVED — the card program needs full KYC same
  /// as any real card issuer (Visa/Mastercard + the issuing bank require it
  /// regardless of where the operating company is registered).
  cardWaitlistJoinedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  balances      Balance[]
  orders        Order[]
  deposits      Deposit[]
  withdrawals   Withdrawal[]
  wallets       Wallet[]
  purchases     Purchase[]
  kycSubmissions KycSubmission[]
  apiKeys       ApiKey[]
  futuresPositions FuturesPosition[]
  futuresBalances  FuturesBalance[]
  futuresOrders    FuturesOrder[]
  /// Set the first time this user confirms the futures risk disclaimer
  /// (see /futures/risk-ack). Must be non-null before any position can be
  /// opened — enforced server-side, not just hidden behind a frontend gate.
  futuresRiskAckAt DateTime?
  supportConversations SupportConversation[]

  @@index([email])
}

enum KycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  USER
  ADMIN
}

/// One row per (user, asset). `available` can be traded; `locked` is reserved
/// by open orders or pending withdrawals. available + locked = total owned.
/// Stored as Decimal (NOT float) — precision loss on money is unacceptable.
model Balance {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  asset     String   // "BTC", "ETH", "USDT", ...
  available Decimal  @default(0) @db.Decimal(36, 18)
  locked    Decimal  @default(0) @db.Decimal(36, 18)
  updatedAt DateTime @updatedAt

  @@unique([userId, asset])
  @@index([userId])
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  pair              String
  side              String      // BUY | SELL
  type              String      // LIMIT | MARKET | STOP_LIMIT | STOP_MARKET | TAKE_PROFIT_LIMIT | TAKE_PROFIT_MARKET
  price             Decimal?    @db.Decimal(36, 18) // execution price for LIMIT-family orders; null for MARKET-family
  /// Trigger price for the STOP and TAKE_PROFIT families — the order sits
  /// out of the matching engine entirely (PENDING_TRIGGER) until the real
  /// market price crosses this, at which point PriceWatcherService submits
  /// it as a real LIMIT/MARKET order. Null for plain LIMIT/MARKET orders.
  triggerPrice      Decimal?    @db.Decimal(36, 18)
  /// Two conditional orders placed as one OCO (One-Cancels-the-Other) pair
  /// share this id — when either leg triggers or fills, PriceWatcherService
  /// cancels the sibling. Null for a standalone order.
  ocoGroupId        String?
  /// Exact amount actually locked for this order at placement time, and
  /// the asset it's locked in. Only set for conditional (STOP/TAKE_PROFIT)
  /// orders — persisted because an OCO pair locks funds ONCE for both legs
  /// (only one will ever execute), so it can't be recomputed from price/
  /// quantity alone at trigger time without risking an incorrect refund.
  lockedAmount      Decimal?    @db.Decimal(36, 18)
  lockedAsset       String?
  originalQuantity  Decimal     @db.Decimal(36, 18)
  remainingQuantity Decimal     @db.Decimal(36, 18)
  status            String      // PENDING_TRIGGER | OPEN | PARTIALLY_FILLED | FILLED | CANCELLED
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
  @@index([pair, status])
  @@index([ocoGroupId])
}

model Trade {
  id            String   @id @default(uuid())
  pair          String
  takerOrderId  String
  makerOrderId  String
  takerUserId   String
  makerUserId   String
  price         Decimal  @db.Decimal(36, 18)
  quantity      Decimal  @db.Decimal(36, 18)
  side          String
  executedAt    DateTime @default(now())

  @@index([pair, executedAt])
}

/// Custodial deposit address assigned to a user for a given asset/chain.
/// Private keys are NEVER stored in this DB — see WalletService / README
/// for the HSM/KMS-backed key custody model.
model Wallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  asset     String
  chain     String   // "ETH", "BTC", "TRON", ...
  address   String
  derivationPath String // path used in the HSM/KMS to derive this address' key — NOT the key itself
  createdAt DateTime @default(now())

  @@unique([asset, chain, address])
  @@index([userId])
}

model Deposit {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  asset         String
  chain         String
  txHash        String
  amount        Decimal  @db.Decimal(36, 18)
  confirmations Int      @default(0)
  status        String   // PENDING | CONFIRMED | CREDITED
  createdAt     DateTime @default(now())

  @@unique([chain, txHash])
  @@index([userId])
}

/// A transfer surfaced by a deposit-verifier's listIncoming() (see
/// adminDeposits.ts) that an admin has confirmed is NOT one of this
/// exchange's deposits — e.g. old unrelated activity a treasury address
/// already had before this deployment started using it. Once ignored, it's
/// permanently filtered out of the "unlinked incoming transfers" feed,
/// the same way an already-credited Deposit is.
model IgnoredIncomingTransfer {
  id        String   @id @default(uuid())
  chain     String
  txHash    String
  createdAt DateTime @default(now())

  @@unique([chain, txHash])
}

/// Manual withdrawal request — the mirror of the manual deposit-crediting
/// flow (see DepositService/adminDeposits.ts): the client requests one
/// (which immediately locks the balance so it can't also be spent trading
/// or double-withdrawn), an admin sends the crypto by hand from the same
/// treasury wallet deposits are received into, and marks the request
/// completed or rejected. No on-chain broadcast/confirmation tracking here
/// — that would only make sense for an automated signer, which this
/// deployment deliberately doesn't have (see config/chains.ts's
/// single-treasury model doc comment).
model Withdrawal {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  asset              String
  /// Free-text network label (e.g. "TRC20", "ERC20", "native") — withdrawal
  /// isn't limited to the few chains this deployment can verify a DEPOSIT
  /// on, since a user can hold (and want to withdraw) any asset they
  /// acquired by trading, not just what they deposited directly.
  network            String
  toAddress          String
  amount             Decimal   @db.Decimal(36, 18)
  /// PENDING (locked, awaiting review) -> APPROVED (admin has reviewed and
  /// intends to send, still locked) -> SENT (admin sent the crypto by hand
  /// and recorded txHash, lock released) — or PENDING -> REJECTED at any
  /// point before SENT (lock released back to available).
  status             String    // PENDING | APPROVED | SENT | REJECTED
  /// Set once the admin has actually broadcast the transaction from the
  /// treasury wallet — filled in on the APPROVED -> SENT transition, never
  /// guessed or pre-filled.
  txHash             String?
  rejectionReason    String?
  performedByAdminId String?   // admin who approved/sent/rejected this
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

/// The single treasury address deposits are watched on for a given chain —
/// admin-editable, overrides the env-var default in config/chains.ts the
/// moment a row exists (see TreasuryWalletService). Deleting a row reverts
/// that chain to its env-var address.
model TreasuryWallet {
  id                 String   @id @default(uuid())
  chain              String   @unique // "bitcoin", "tron", "ethereum", ...
  address            String
  updatedByAdminId   String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

/// Immutable audit log — every balance-affecting action gets a row.
/// This is what you reconcile against in a security incident.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  metadata  Json
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}

/// A product or service you sell through the exchange. Only an admin
/// (User.role == ADMIN) can create/edit these — see requireAdmin middleware.
model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  priceAmount Decimal  @db.Decimal(36, 18)
  priceAsset  String   // e.g. "USDT" — must match an asset users hold a Balance in
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases   Purchase[]

  @@index([active])
}

/// A user's submission of identity documents for KYC review — country,
/// legal name, date of birth, and a photo of a passport/ID/driver's
/// license. `documentImagePath` points at a file on local disk
/// (`uploads/kyc/`), NOT committed to the repo (see .gitignore).
///
/// IMPORTANT: this is a submission + manual-review scaffold, not real
/// identity verification. Nothing here checks that the document is
/// genuine, matches the photo, or passes sanctions/PEP screening — an
/// admin just looks at the image and clicks approve/reject (same manual
/// pattern as Purchase fulfillment). Storing raw passport scans on local
/// disk, unencrypted, is not compliant with real KYC/AML regulation
/// (GDPR "special category data" in the EU, MiCA, FINMA VASP, etc. — see
/// README). Before this holds real users' documents, replace it with a
/// licensed provider (Sumsub, Onfido, Jumio) that does real document +
/// liveness verification and sanctions screening.
model KycSubmission {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  country           String    // ISO 3166-1 alpha-2, e.g. "UA"
  fullName          String
  dateOfBirth       DateTime
  documentType      String    // PASSPORT | ID_CARD | DRIVERS_LICENSE
  documentImagePath String
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason   String?
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([status])
}

/// A programmatic API key for connecting a trading bot/script (see
/// src/api/middleware/apiKeyAuth.ts). `apiKey` is the public identifier;
/// the actual secret is shown to the user ONCE at creation and stored here
/// only encrypted (AES-256-GCM, API_KEY_ENCRYPTION_SECRET) — not hashed,
/// because HMAC request signing needs the raw secret back, unlike a login
/// password. `canTrade=false` keys can only read balances/orders, never
/// place or cancel one.
model ApiKey {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  label            String
  apiKey           String    @unique
  encryptedSecret  String
  canTrade         Boolean   @default(false)
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?

  @@index([userId])
}

/// A record of a user "paying" for a product with their internal balance.
/// The balance was funded by a real on-chain deposit earlier (see Deposit) —
/// this model never touches the blockchain itself, it just moves the
/// internal ledger number and marks what still needs to be delivered.
model Purchase {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  amount     Decimal  @db.Decimal(36, 18) // snapshot of price at purchase time
  asset      String
  status     String   // PENDING_FULFILLMENT | FULFILLED | REFUNDED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/// Separate wallet from the spot Balance model on purpose — futures margin
/// is collateral backing leveraged risk, spot balance is just owned coins.
/// Keeping them apart means a liquidation or funding payment can never
/// silently reach into a user's spot holdings, and vice versa. Users move
/// funds between the two explicitly (see /futures/transfer).
model FuturesBalance {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  asset     String
  available Decimal  @default(0) @db.Decimal(36, 18)
  locked    Decimal  @default(0) @db.Decimal(36, 18) // margin backing open positions
  updatedAt DateTime @updatedAt

  @@unique([userId, asset])
  @@index([userId])
}

/// Mirrors the spot Order model, kept as a fully separate table (not just
/// a namespaced pair on the spot Order table) so futures order flow can
/// never accidentally share code paths with spot balance-locking — a
/// futures fill must only ever touch FuturesBalance/FuturesPosition, never
/// the spot Balance table.
model FuturesOrder {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  symbol            String
  side              String   // BUY | SELL — direction of this order, not the resulting position side
  type              String   // LIMIT | MARKET
  price             Decimal? @db.Decimal(36, 18)
  originalQuantity  Decimal  @db.Decimal(36, 18)
  remainingQuantity Decimal  @db.Decimal(36, 18)
  status            String   // OPEN | PARTIALLY_FILLED | FILLED | CANCELLED
  reduceOnly        Boolean  @default(false) // true when closing/reducing a position rather than opening one
  leverage          Int      // carried on the order so a resting order that fills later still knows what leverage to open/add at
  marginType        String   // ISOLATED | CROSS — same reason as leverage
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([symbol, status])
}

/// One row per open or closed perpetual futures position. A user can hold
/// at most one position per (symbol, marginType) at a time — adding to a
/// position averages the entry price rather than creating a second row,
/// same as every real exchange (you can't have two independent longs on
/// the same isolated-margin symbol).
model FuturesPosition {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  symbol           String   // "BTC/USDT" — reuses the spot pair naming, priced off the same index
  side             String   // LONG | SHORT
  size             Decimal  @db.Decimal(36, 18) // base-asset quantity, always positive
  entryPrice       Decimal  @db.Decimal(36, 18) // size-weighted average entry
  leverage         Int
  marginType       String   // ISOLATED | CROSS
  initialMargin    Decimal  @db.Decimal(36, 18) // margin currently allocated to this position (isolated); for cross, the margin set aside at open
  liquidationPrice Decimal  @db.Decimal(36, 18)
  status           String   @default("OPEN") // OPEN | CLOSED | LIQUIDATED
  realizedPnl      Decimal  @default(0) @db.Decimal(36, 18)
  openedAt         DateTime @default(now())
  closedAt         DateTime?
  updatedAt        DateTime @updatedAt

  fundingPayments  FundingPayment[]

  @@index([userId, status])
  @@index([symbol, status])
}

/// One row per funding interval per symbol — the rate actually applied,
/// plus the mark/index prices it was computed from, so a payment can
/// always be reconstructed/audited after the fact.
model FundingRateRecord {
  id         String   @id @default(uuid())
  symbol     String
  rate       Decimal  @db.Decimal(20, 10) // e.g. 0.0001 = 0.01%
  markPrice  Decimal  @db.Decimal(36, 18)
  indexPrice Decimal  @db.Decimal(36, 18)
  appliedAt  DateTime @default(now())

  @@index([symbol, appliedAt])
}

/// One row per position per funding interval it was charged/paid for.
/// amount is signed from the position's point of view: negative = paid
/// out, positive = received.
model FundingPayment {
  id         String          @id @default(uuid())
  positionId String
  position   FuturesPosition @relation(fields: [positionId], references: [id])
  userId     String
  symbol     String
  amount     Decimal         @db.Decimal(36, 18)
  rate       Decimal         @db.Decimal(20, 10)
  createdAt  DateTime        @default(now())

  @@index([positionId])
  @@index([userId])
}

/// Per-asset insurance fund balance — absorbs the shortfall when a
/// liquidation executes worse than the position's bankruptcy price (so
/// other users never get auto-deleveraged for it), and absorbs the
/// surplus when a liquidation executes better than bankruptcy price.
/// Standard practice on every real derivatives exchange.
model InsuranceFund {
  id        String   @id @default(uuid())
  asset     String   @unique
  balance   Decimal  @default(0) @db.Decimal(36, 18)
  updatedAt DateTime @updatedAt
}

/// Immutable ledger of every insurance-fund movement — mirrors AuditLog's
/// "never just mutate the number, always leave a record" rule, scoped to
/// the fund specifically so it can be reconciled on its own.
model InsuranceFundLedger {
  id         String   @id @default(uuid())
  asset      String
  amount     Decimal  @db.Decimal(36, 18) // positive = contribution, negative = payout
  reason     String   // LIQUIDATION_SURPLUS | LIQUIDATION_SHORTFALL
  positionId String?
  createdAt  DateTime @default(now())

  @@index([asset, createdAt])
}

enum SupportSubject {
  TECHNICAL
  KYC
  CARD
  OTHER
}

enum SupportSender {
  USER
  ADMIN
}

/// One support chat thread. `id` itself doubles as the ticket number
/// referenced in outbound admin-notification emails (`[Ticket #<id>]`) —
/// no separate token needed since it's already a random, unguessable
/// UUID. `userId` is null for a guest (not logged in): a guest's only
/// "credential" is knowing this conversation's id, which the frontend
/// keeps in localStorage — the same anonymous-visitor-id trust model
/// Intercom/Zendesk widgets themselves use. `guestName`/`guestEmail` are
/// always collected via the pre-chat form (even for a logged-in user,
/// since User has no name field) so support has a name/contact email to
/// reply to regardless of account status.
model SupportConversation {
  id           String         @id @default(uuid())
  userId       String?
  user         User?          @relation(fields: [userId], references: [id])
  guestName    String
  guestEmail   String
  subject      SupportSubject
  /// Flips true when an admin reply lands via the inbound-email webhook;
  /// drives the floating widget's unread badge. Cleared by POST .../read.
  unreadByUser Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  messages     SupportMessage[]

  @@index([userId])
}

model SupportMessage {
  id             String              @id @default(uuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id])
  sender         SupportSender
  body           String
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}
