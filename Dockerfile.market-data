FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.collector.json ./
COPY src/services/marketData ./src/services/marketData
COPY src/marketDataCollector.ts ./src/marketDataCollector.ts
RUN npx tsc -p tsconfig.collector.json

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /app/dist ./dist
USER node
EXPOSE 10000
CMD ["node", "dist/marketDataCollector.js"]
